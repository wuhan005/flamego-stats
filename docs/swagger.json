                    "type": "boolean"
                },
                "removed": {
                    "type": "integer"
                },
                "reportedTotal": {
                    "type": "integer"
                },
                "skipped": {
                    "type": "integer"
                },
                "startedAt": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "running",
                        "succeeded",
                        "failed"
                    ]
                },
                "synced": {
                    "type": "integer"
                }
            }
        }
    }
