{
    "swagger": "2.0",
    "info": {
        "title": "Flamego Stats API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/_",
    "paths": {
        "/activities": {
            "get": {
                "description": "The commits, pull requests, issues and releases of the repositories of the organization, the newest first.\nWithout the type, the commits squash-merged from the pull requests are folded into the merged pull requests.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the activities",
                "operationId": "listActivities",
                "parameters": [
                    {
                        "enum": [
                            "commit",
                            "pull_request",
                            "issue",
                            "release"
                        ],
                        "type": "string",
                        "description": "Type of the activities, all of them if empty",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by the repository name, case-insensitively",
                        "name": "repository",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Exclude the activities of the GitHub Apps, defaults to false",
                        "name": "excludeBots",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "The nextCursor of the previous page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ListActivitiesResp"
                        }
                    },
                    "400": {
                        "description": "Invalid type or cursor",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/activities/summary": {
            "get": {
                "description": "The counts of the last 30 days and the 30 days before, the daily counts of the last 13 weeks, the repositories, the top contributors and the latest releases.",
                "produces": [
                    "application/json"
                ],
                "summary": "Summarize the activities",
                "operationId": "getActivitySummary",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Exclude the activities of the GitHub Apps, defaults to false",
                        "name": "excludeBots",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "IANA time zone of the daily counts, e.g. Asia/Shanghai, defaults to UTC",
                        "name": "tz",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ActivitySummary"
                        }
                    },
                    "400": {
                        "description": "Invalid tz",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/overview": {
            "get": {
                "description": "The totals of the dependents, owners, stars and forks, along with the latest succeeded synchronization.",
                "produces": [
                    "application/json"
                ],
                "summary": "Get the overview",
                "operationId": "getOverview",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/Overview"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/repositories": {
            "get": {
                "description": "List the repositories depending on the module, sort=stars ranks by stars and sort=pushed lists the recently updated.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the dependents",
                "operationId": "listRepositories",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number, starting from 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size, defaults to 20, at most 100",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "stars",
                            "forks",
                            "pushed",
                            "created",
                            "name"
                        ],
                        "type": "string",
                        "description": "Order of the list, defaults to stars",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Match the full name and the description",
                        "name": "keyword",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by the topic",
                        "name": "topic",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by the primary language",
                        "name": "language",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by the owner, case-insensitively",
                        "name": "owner",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by the module version, e.g. v1.9.4",
                        "name": "version",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ListRepositoriesResp"
                        }
                    },
                    "400": {
                        "description": "Invalid sort",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/go-versions": {
            "get": {
                "description": "The MAJOR.MINOR distribution of the go directive in the go.mod of the dependents, in descending version order.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the Go versions",
                "operationId": "listGoVersions",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CountItem"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/languages": {
            "get": {
                "description": "The primary languages ordered by the number of dependents.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the languages",
                "operationId": "listLanguages",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CountItem"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/modules": {
            "get": {
                "description": "The other modules of the same organization (e.g. github.com/flamego/session) used by the dependents, ordered by the number of dependents.",
                "produces": [
                    "application/json"
                ],
                "summary": "Rank the related modules",
                "operationId": "listModules",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CountItem"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/owners": {
            "get": {
                "description": "The owners ordered by the number of dependents, then by the total stars.",
                "produces": [
                    "application/json"
                ],
                "summary": "Rank the owners",
                "operationId": "listTopOwners",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/OwnerRank"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/topics": {
            "get": {
                "description": "The repository topics ordered by the number of dependents.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the topics",
                "operationId": "listTopics",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CountItem"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stats/versions": {
            "get": {
                "description": "The distribution of the module versions in the go.mod of the dependents, in descending version order.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the module versions",
                "operationId": "listVersions",
                "parameters": [
                    {
                        "enum": [
                            "exact",
                            "minor"
                        ],
                        "type": "string",
                        "description": "Group by the exact or the minor versions, defaults to exact",
                        "name": "granularity",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Include the forked repositories, defaults to false",
                        "name": "includeForks",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CountItem"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid granularity",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/sync-runs": {
            "get": {
                "description": "The latest synchronization runs, the newest first. The discovered counts chart the trend of the dependents.",
                "produces": [
                    "application/json"
                ],
                "summary": "List the synchronization runs",
                "operationId": "listSyncRuns",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Number of items, defaults to 20, at most 100",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/SyncRun"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "Activity": {
            "type": "object",
            "required": [
                "action",
                "actor",
                "draft",
                "htmlURL",
                "id",
                "number",
                "occurredAt",
                "prerelease",
                "repository",
                "sha",
                "tag",
                "title",
                "type"
            ],
            "properties": {
                "action": {
                    "type": "string",
                    "enum": [
                        "committed",
                        "opened",
                        "merged",
                        "closed",
                        "published"
                    ]
                },
                "actor": {
                    "$ref": "#/definitions/Actor"
                },
                "draft": {
                    "type": "boolean"
                },
                "htmlURL": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "number": {
                    "description": "Number is the number of the pull request or the issue. For a commit, it is the pull request squash-merged as it, or 0.",
                    "type": "integer"
                },
                "occurredAt": {
                    "type": "string"
                },
                "prerelease": {
                    "type": "boolean"
                },
                "repository": {
                    "$ref": "#/definitions/ActivityRepositoryBrief"
                },
                "sha": {
                    "description": "SHA is the hash of the commit, Tag is the tag name of the release.",
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "commit",
                        "pull_request",
                        "issue",
                        "release"
                    ]
                }
            }
        },
        "ActivityCounts": {
            "type": "object",
            "required": [
                "closedIssues",
                "commits",
                "mergedPullRequests",
                "openedIssues",
                "openedPullRequests",
                "releases"
            ],
            "properties": {
                "closedIssues": {
                    "type": "integer"
                },
                "commits": {
                    "type": "integer"
                },
                "mergedPullRequests": {
                    "type": "integer"
                },
                "openedIssues": {
                    "type": "integer"
                },
                "openedPullRequests": {
                    "type": "integer"
                },
                "releases": {
                    "type": "integer"
                }
            }
        },
        "ActivityRepositoryBrief": {
            "type": "object",
            "required": [
                "htmlURL",
                "name"
            ],
            "properties": {
                "htmlURL": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "ActivitySummary": {
            "type": "object",
            "required": [
                "contributors",
                "current",
                "daily",
                "days",
                "lastSyncedAt",
                "organization",
                "previous",
                "releases",
                "repositories"
            ],
            "properties": {
                "contributors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Contributor"
                    }
                },
                "current": {
                    "$ref": "#/definitions/ActivityCounts"
                },
                "daily": {
                    "description": "Daily is every day of the recent weeks, the oldest first and today the last.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/DailyCount"
                    }
                },
                "days": {
                    "description": "Days is the length of the period of Current, Repositories and Contributors, which ends now.",
                    "type": "integer"
                },
                "lastSyncedAt": {
                    "type": "string",
                    "x-nullable": true
                },
                "organization": {
                    "type": "string"
                },
                "previous": {
                    "description": "Previous is the counts of the period of the same length before Current.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/ActivityCounts"
                        }
                    ]
                },
                "releases": {
                    "description": "Releases are the latest releases.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Activity"
                    }
                },
                "repositories": {
                    "description": "Repositories are all the tracked repositories, the most active first.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RepositoryActivity"
                    }
                }
            }
        },
        "Actor": {
            "type": "object",
            "required": [
                "avatarURL",
                "bot",
                "htmlURL",
                "login"
            ],
            "properties": {
                "avatarURL": {
                    "type": "string"
                },
                "bot": {
                    "type": "boolean"
                },
                "htmlURL": {
                    "type": "string"
                },
                "login": {
                    "description": "Login is the name in the commit if the commit author is not linked to any account, AvatarURL and HTMLURL are empty then.",
                    "type": "string"
                }
            }
        },
        "Contributor": {
            "type": "object",
            "required": [
                "avatarURL",
                "bot",
                "count",
                "htmlURL",
                "login"
            ],
            "properties": {
                "avatarURL": {
                    "type": "string"
                },
                "bot": {
                    "type": "boolean"
                },
                "count": {
                    "type": "integer"
                },
                "htmlURL": {
                    "type": "string"
                },
                "login": {
                    "description": "Login is the name in the commit if the commit author is not linked to any account, AvatarURL and HTMLURL are empty then.",
                    "type": "string"
                }
            }
        },
        "CountItem": {
            "type": "object",
            "required": [
                "count",
                "name"
            ],
            "properties": {
                "count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "DailyCount": {
            "type": "object",
            "required": [
                "count",
                "date"
            ],
            "properties": {
                "count": {
                    "type": "integer"
                },
                "date": {
                    "description": "Date is in the format of 2006-01-02 in the requested time zone.",
                    "type": "string"
                }
            }
        },
        "ListActivitiesResp": {
            "type": "object",
            "required": [
                "activities",
                "nextCursor"
            ],
            "properties": {
                "activities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Activity"
                    }
                },
                "nextCursor": {
                    "description": "NextCursor lists the following activities as the cursor parameter, it is empty at the end of the feed.",
                    "type": "string"
                }
            }
        },
        "ListRepositoriesResp": {
            "type": "object",
            "required": [
                "repositories",
                "total"
            ],
            "properties": {
                "repositories": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Repository"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "Overview": {
            "type": "object",
            "required": [
                "forks",
                "lastSyncedAt",
                "module",
                "owners",
                "reportedTotal",
                "repositories",
                "repository",
                "resolved",
                "stars"
            ],
            "properties": {
                "forks": {
                    "type": "integer"
                },
                "lastSyncedAt": {
                    "description": "LastSyncedAt is when the latest succeeded synchronization finished, it is null if never synchronized.",
                    "type": "string",
                    "x-nullable": true
                },
                "module": {
                    "type": "string"
                },
                "owners": {
                    "type": "integer"
                },
                "reportedTotal": {
                    "description": "ReportedTotal is the approximate number shown in \"Used by\" on GitHub, including the forked and private repositories.",
                    "type": "integer"
                },
                "repositories": {
                    "type": "integer"
                },
                "repository": {
                    "description": "Repository and Module are the repository and the Go module to collect the dependents of.",
                    "type": "string"
                },
                "resolved": {
                    "description": "Resolved is the number of dependents whose module version is resolved.",
                    "type": "integer"
                },
                "stars": {
                    "type": "integer"
                }
            }
        },
        "OwnerBrief": {
            "type": "object",
            "required": [
                "avatarURL",
                "htmlURL",
                "login",
                "type"
            ],
            "properties": {
                "avatarURL": {
                    "type": "string"
                },
                "htmlURL": {
                    "type": "string"
                },
                "login": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "User",
                        "Organization"
                    ]
                }
            }
        },
        "OwnerRank": {
            "type": "object",
            "required": [
                "avatarURL",
                "htmlURL",
                "login",
                "repositories",
                "stars",
                "type"
            ],
            "properties": {
                "avatarURL": {
                    "type": "string"
                },
                "htmlURL": {
                    "type": "string"
                },
                "login": {
                    "type": "string"
                },
                "repositories": {
                    "type": "integer"
                },
                "stars": {
                    "type": "integer"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "User",
                        "Organization"
                    ]
                }
            }
        },
        "Repository": {
            "type": "object",
            "required": [
                "archived",
                "createdAt",
                "description",
                "fork",
                "forks",
                "fullName",
                "goModPath",
                "goVersion",
                "homepage",
                "htmlURL",
                "language",
                "license",
                "moduleVersion",
                "name",
                "openIssues",
                "owner",
                "pushedAt",
                "relatedModules",
                "stars",
                "syncedAt",
                "topics",
                "watchers"
            ],
            "properties": {
                "archived": {
                    "type": "boolean"
                },
                "createdAt": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "fork": {
                    "type": "boolean"
                },
                "forks": {
                    "type": "integer"
                },
                "fullName": {
                    "type": "string"
                },
                "goModPath": {
                    "description": "GoModPath is the path of the go.mod requiring the module. If not found, it is empty along with GoVersion and ModuleVersion.",
                    "type": "string"
                },
                "goVersion": {
                    "type": "string"
                },
                "homepage": {
                    "type": "string"
                },
                "htmlURL": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "license": {
                    "type": "string"
                },
                "moduleVersion": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "openIssues": {
                    "type": "integer"
                },
                "owner": {
                    "$ref": "#/definitions/OwnerBrief"
                },
                "pushedAt": {
                    "type": "string"
                },
                "relatedModules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "stars": {
                    "type": "integer"
                },
                "syncedAt": {
                    "type": "string"
                },
                "topics": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "watchers": {
                    "type": "integer"
                }
            }
        },
        "RepositoryActivity": {
            "type": "object",
            "required": [
                "archived",
                "count",
                "description",
                "htmlURL",
                "name"
            ],
            "properties": {
                "archived": {
                    "type": "boolean"
                },
                "count": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "htmlURL": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "SyncRun": {
            "type": "object",
            "required": [
                "discovered",
                "error",
                "failed",
                "finishedAt",
                "id",
                "partial",
                "removed",
                "reportedTotal",
                "skipped",
                "startedAt",
                "status",
                "synced"
            ],
            "properties": {
                "discovered": {
                    "type": "integer"
                },
                "error": {
                    "description": "Error is why the run failed, or why the succeeded run is partial.",
                    "type": "string"
                },
                "failed": {
                    "type": "integer"
                },
                "finishedAt": {
                    "type": "string",
                    "x-nullable": true
                },
                "id": {
                    "type": "integer"
                },
